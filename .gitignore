node_modules/
.DS_Store
*.log
# test scratch
.test-tmp*/
facade/.test-tmp*/
# everything derived is a deletable cache beside a log (see facade/SIG.md): never commit one
*.sig/
*.marks/
*.derived/
*.keys/
# downloaded third-party papers stay local; only the index and the notes about them are tracked
sources/*
!sources/NOTES.md
!sources/INDEX.tsv
# local route settings (may contain a mailbox token): never commit
app/config.js
# mailbox runtime: the master key is a secret, objects are data — never commit
app/mailbox/master.key
app/mailbox/objects/
# seeded demo log is data, not source
demo/log/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# spaces are encrypted data, not source
spaces/
